---
/** Tiny pixel-art icons drawn from ASCII grids ("#" = filled). */
const ICONS: Record<string, string[]> = {
  map: ['#..##..#', '##.##.##', '########', '#.##.###', '########', '##.##.##', '#..##..#', '........'],
  book: ['.######.', '#......#', '#.####.#', '#......#', '#.###..#', '#......#', '.######.', '........'],
  sun: ['...#....', '.#...#..', '...##...', '#.####.#', '..####..', '.#.##.#.', '...#....', '........'],
  sound: ['...#....', '..##..#.', '####.#.#', '####.#.#', '####.#.#', '..##..#.', '...#....', '........'],
  plus: ['........', '...##...', '...##...', '.######.', '.######.', '...##...', '...##...', '........'],
  minus: ['........', '........', '........', '.######.', '.######.', '........', '........', '........'],
  close: ['........', '.##..##.', '..####..', '...##...', '..####..', '.##..##.', '........', '........'],
  leaf: ['........', '....###.', '..#####.', '.#####..', '.####...', '.##.....', '#.......', '........'],
};
interface Props { name: keyof typeof ICONS; size?: number }
const { name, size = 16 } = Astro.props;
const rows = ICONS[name];
---
<svg class="px-icon" width={size} height={size} viewBox="0 0 8 8" shape-rendering="crispEdges" aria-hidden="true">
  {rows.flatMap((row, y) => [...row].map((c, x) => (c === '#' ? <rect x={x} y={y} width="1" height="1" /> : null)))}
</svg>
