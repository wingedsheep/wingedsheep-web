---
import 'katex/dist/katex.min.css';
import { getCollection, render } from 'astro:content';
import IslandShell from '../../components/IslandShell.astro';
import { size } from '../../lib/rehype-pages.mjs';
import { projects } from '../../data/projects';
import { SUBJECTS, spineColor } from '../../data/subjects';
import { site } from '../../data/site';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, prev: posts[i - 1], next: posts[i + 1] },
  }));
}

const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);
const long = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const short = (d: Date) => d.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });
// reading time from the words in the text (tags and markup stripped)
const words = (post.body ?? '').replace(/<[^>]+>|!\[[^\]]*\]\([^)]*\)|[#*_`>|-]/g, ' ').split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 230));
// a contents list for longer posts, unless the post already links to its own sections
const ownContents = ((post.body ?? '').match(/\]\(#/g) ?? []).length >= 3;
const contents = ownContents ? [] : headings.filter((h) => h.depth === 2);
const subject = SUBJECTS[post.data.shelf];
const url = new URL(`/blog/${post.id}/`, Astro.site).href;
const home = Astro.site!.href;
// the cover's real size: the image keeps its place as it loads, and search engines get it too
const coverSize = post.data.cover ? size(post.data.cover) : null;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      '@id': `${url}#post`,
      headline: post.data.title,
      description: post.data.excerpt,
      datePublished: post.data.date.toISOString(),
      inLanguage: 'en',
      url,
      mainEntityOfPage: url,
      image: {
        '@type': 'ImageObject',
        url: new URL(post.data.cover ?? '/og.png', Astro.site).href,
        ...(post.data.cover ? coverSize && { width: coverSize[0], height: coverSize[1] } : { width: 1200, height: 630 }),
      },
      keywords: post.data.tags.join(', ') || undefined,
      articleSection: subject.name,
      wordCount: words,
      timeRequired: `PT${minutes}M`,
      author: { '@type': 'Person', '@id': `${home}#person`, name: site.name, url: home },
      publisher: { '@id': `${home}#person` },
      isPartOf: { '@type': 'Blog', '@id': `${home}blog/#blog`, name: `The library · ${site.handle}`, url: `${home}blog/` },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: site.handle, item: home },
        { '@type': 'ListItem', position: 2, name: 'The library', item: `${home}blog/` },
        { '@type': 'ListItem', position: 3, name: post.data.title },
      ],
    },
  ],
};
// a post that tells a project's story links to the project itself
const project = projects.find((p) => p.post === post.id);
const out = (href: string) => (href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {});
---
<Base title={post.data.title} description={post.data.excerpt} image={post.data.cover} published={post.data.date} jsonLd={jsonLd}>
  <IslandShell hasArticle>
    <header class="article-head" style={`--spine:${spineColor(post.id, post.data.shelf)}`}>
      <p class="article-meta">
        <span class="article-subject">{subject.name}</span>
        <time datetime={post.data.date.toISOString().slice(0, 10)}>{long(post.data.date)}</time>
        <span>{minutes} min read</span>
      </p>
      <h1 tabindex="-1">{post.data.title}</h1>
      <p class="article-excerpt">{post.data.excerpt}</p>
      {post.data.tags.length > 0 && <p class="article-tags">{post.data.tags.map((t) => <span>{t}</span>)}</p>}
      <div class="fleuron" aria-hidden="true"><i></i><i></i><i></i></div>
    </header>
    {project && (project.href !== `/blog/${post.id}/` || project.source) && (
      <aside class="article-plaque" style={`--spine:${project.color}`} aria-label="The project">
        <span>In the workshop</span>
        <strong>{project.name}</strong>
        {project.href !== `/blog/${post.id}/` && <a href={project.href} {...out(project.href)}>{project.href.includes('github.com') ? 'Source' : 'Visit'} ↗</a>}
        {project.source && project.source !== project.href && <a href={project.source} {...out(project.source)}>Source ↗</a>}
      </aside>
    )}
    {post.data.cover && <figure class="article-cover"><img src={post.data.cover} alt="" width={coverSize?.[0]} height={coverSize?.[1]} fetchpriority="high" /></figure>}
    {contents.length >= 3 && (
      <nav class="article-contents" aria-label="Contents">
        <p class="article-contents-title">In this book</p>
        <ol>{contents.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
      </nav>
    )}
    <div class="prose"><Content /></div>
    <footer class="article-end">
      <div class="fleuron" aria-hidden="true"><i></i><i></i><i></i></div>
      <nav class="article-nav" aria-label="More books">
        {prev ? (
          <a class="shelf-neighbour" href={`/blog/${prev.id}/`} data-book={prev.id} style={`--spine:${spineColor(prev.id, prev.data.shelf)}`}>
            <span class="neighbour-dir">← older</span>
            <strong>{prev.data.title}</strong>
            <span class="neighbour-date">{short(prev.data.date)}</span>
          </a>
        ) : <span />}
        {next ? (
          <a class="shelf-neighbour next" href={`/blog/${next.id}/`} data-book={next.id} style={`--spine:${spineColor(next.id, next.data.shelf)}`}>
            <span class="neighbour-dir">newer →</span>
            <strong>{next.data.title}</strong>
            <span class="neighbour-date">{short(next.data.date)}</span>
          </a>
        ) : <span />}
      </nav>
      <p class="article-cookies"><a href="#cookies" data-cookie-settings>Cookie settings</a></p>
    </footer>
  </IslandShell>
</Base>
