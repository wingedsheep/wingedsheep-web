---
/**
 * The island page: canvas, HUD, and every panel (server-rendered so they work for search
 * engines, screen readers and people without WebGL). The island script only shows and hides
 * them. Pass an article in the default slot to render /blog/<slug>/ with the book open.
 */
import { getCollection } from 'astro:content';
import { SECRETS } from '../island/content';
import { RIVERS } from '../island/river/rivers';
import { chapters } from '../data/career';
import piano from '../data/piano.json';
import { projects } from '../data/projects';
import records from '../data/records.json';
import { site } from '../data/site';
import { skills } from '../data/skills';
import { type BookInfo, SUBJECTS, type Subject, spineColor, tagKey } from '../data/subjects';
import PixelIcon from './PixelIcon.astro';
import RiverTipArt from './RiverTipArt.astro';

interface Props {
  hasArticle?: boolean;
  /** a panel that's open as the page arrives (/blog/ is the library), there before the island is */
  open?: 'library';
}
const { hasArticle = false, open } = Astro.props;
const BrandHeading = hasArticle ? 'p' : 'h1';

// the river game's what-to-do-when, on the start card and the pause card (and one at a time,
// a different one each time, out on the start card)
// (each with its picture, from tools/drawings/river-tips.py)
const RIVER_TIPS: [string, string, string][] = [
  ['tip', 'Tipping over', 'Lean against it. If she keeps going, brace: you’ve one brace in you every few seconds (the balance gauge goes dashed till then), so in big water keep leaning.'],
  ['roll', 'Upside down', 'Roll when the needle swings into the gap. Miss it and you swim, and your flow goes with you.'],
  ['big', 'Big water', 'Point straight down it, lean forward and keep paddling. Broadside down a wave train, a leaning crest rolls you: lean into it, or square up.'],
  ['rocks', 'Rocks ahead', 'Follow the arrows down the dark V between them. A knock costs your flow; steer early, a reverse sweep turns you even when you’re barely moving.'],
  ['ledge', 'A ledge', 'Paddle hard just as the lip glows gold, to boof it. Too soon or too late and you land flat, or nose first.'],
  ['falls', 'A waterfall', 'The lip pulls you round: line up well before it and go over straight, leaning forward. Off it sideways throws you hard, and stops you.'],
  ['hole', 'Stuck in a hole', 'Lean forward and paddle hard till it lets you go.'],
  ['split', 'The river splits', 'The hero line is quicker and pays more; the sneak is the easier way down.'],
  ['eddy', 'Need a breather', 'Tuck in behind a rock or inside a bend: an eddy, where the water turns back upstream. Lean into the turn as you cross the eddy line.'],
];

// the library: every post is an index card, filed by year, newest first
const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const years = [...new Set(posts.map((p) => p.data.date.getFullYear()))].map((year) => ({
  year,
  posts: posts.filter((p) => p.data.date.getFullYear() === year),
}));
const subjects = (Object.keys(SUBJECTS) as Subject[])
  .map((id) => ({ id, ...SUBJECTS[id], count: posts.filter((p) => p.data.shelf === id).length }))
  .filter((s) => s.count);
const tagMap = new Map<string, { key: string; label: string; count: number }>();
for (const tag of posts.flatMap((p) => p.data.tags)) {
  const t = tagMap.get(tagKey(tag)) ?? tagMap.set(tagKey(tag), { key: tagKey(tag), label: tag, count: 0 }).get(tagKey(tag))!;
  t.count++;
}
const tags = [...tagMap.values()].sort((a, b) => b.count - a.count || a.label.localeCompare(b.label));
const commonTags = tags.filter((t) => t.count > 1);
const rareTags = tags.filter((t) => t.count === 1).sort((a, b) => a.label.localeCompare(b.label));
const books: BookInfo[] = posts.map((p) => ({
  slug: p.id,
  title: p.data.title,
  date: p.data.date.toISOString().slice(0, 10),
  subject: p.data.shelf,
  tags: p.data.tags.map(tagKey),
}));
const MONTHS = ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'];
const minutes = (s: number) => `${Math.floor(s / 60)}:${String(Math.round(s % 60)).padStart(2, '0')}`;
const projectYears = [...new Set(projects.map((p) => p.year))]
  .sort((a, b) => b - a)
  .map((year) => ({ year, items: projects.filter((p) => p.year === year) }));
const places = [
  { id: 'library', label: 'Library', hint: 'the blog' },
  { id: 'workshop', label: 'Workshop', hint: 'projects' },
  { id: 'campfire', label: 'Campfire', hint: 'about me' },
  { id: 'cairn_0', label: 'Mountain trail', hint: 'career & skills' },
  { id: 'hut', label: 'Mountain hut', hint: 'stop for the night' },
  { id: 'lighthouse', label: 'Lighthouse', hint: 'the keeper' },
];
---
<div class="island-page">
  <div id="island" class="island" role="region" aria-label="An island you can explore. Use the places menu to navigate with a keyboard.">
    <p class="island-loading">Rowing over…</p>
  </div>

  <header class="brand">
    <BrandHeading class="brand-heading"><a href="/" class="brand-name">{site.handle}</a></BrandHeading>
    <p class="brand-tag">{site.name} · {site.tagline}</p>
    <a class="brand-work" href="/commissions/">Commissioned work: websites, 3D, AI and games →</a>
  </header>

  <nav class="hud" aria-label="Island controls">
    <button class="hud-btn" data-action="places" aria-label="Places"><PixelIcon name="map" /><span>Places</span></button>
    <button class="hud-btn" data-action="journal" aria-label="Journal"><PixelIcon name="book" /><span data-journal-count>0/{Object.keys(SECRETS).length}</span></button>
    <button class="hud-btn" data-action="sound" aria-pressed="true" aria-label="Sound"><PixelIcon name="sound" /></button>
    <a class="hud-btn hud-plain" href="/plain/">Just the facts</a>
  </nav>

  <p class="hint">Drag to explore · scroll to zoom · Q/E to turn · click what looks interesting</p>

  <!-- panels ------------------------------------------------------------------------ -->
  <section class="panel panel-library" data-panel="library" hidden={open !== 'library'} aria-labelledby="library-title">
    <button class="sheet-grip" data-grip aria-label="Fold the catalogue down or up"></button>
    <button class="panel-close" data-close aria-label="Put the catalogue away"><PixelIcon name="close" /></button>
    <h2 id="library-title" tabindex="-1">The library</h2>
    <p class="panel-lede">Everything I've written, one shelf for every year. Every book has a card in
      this drawer. And the piano in the corner plays.</p>

    <div class="filters" role="group" aria-label="Filter by subject">
      {subjects.map((s) => (
        <button class="subject" data-subject={s.id} aria-pressed="false" style={`--spine:${s.colors[0]}`}>
          <i class="swatch" aria-hidden="true"></i><span data-name>{s.name}</span> <span class="count">{s.count}</span>
        </button>
      ))}
    </div>
    <div class="filters tag-filters" role="group" aria-label="Filter by tag">
      {commonTags.map((t) => (
        <button class="tag" data-tag={t.key} aria-pressed="false"><span data-name>{t.label}</span> <span class="count">{t.count}</span></button>
      ))}
      <span class="tags-more" hidden>
        {rareTags.map((t) => <button class="tag" data-tag={t.key} aria-pressed="false"><span data-name>{t.label}</span></button>)}
      </span>
      {rareTags.length > 0 && <button class="tag tag-more" data-more={`+${rareTags.length} more`} aria-expanded="false">+{rareTags.length} more</button>}
    </div>
    <p class="filter-status" data-status hidden aria-live="polite"><span data-status-text></span> <button data-clear>show all</button></p>

    <ol class="catalogue">
      {years.map((y) => (
        <li class="drawer" data-year={y.year}>
          <h3 class="drawer-label"><span class="drawer-plate">{y.year}</span><span class="drawer-count">{y.posts.length} {y.posts.length === 1 ? 'post' : 'posts'}</span></h3>
          <ol class="cards">
            {y.posts.map((p) => (
              <li class="card" data-slug={p.id} data-subject-of={p.data.shelf} data-tags={p.data.tags.map(tagKey).join('|')} style={`--spine:${spineColor(p.id, p.data.shelf)}`}>
                <a class="card-link" href={`/blog/${p.id}/`} data-book={p.id}>
                  <time class="card-stamp" datetime={p.data.date.toISOString().slice(0, 10)}>
                    <b>{String(p.data.date.getDate()).padStart(2, '0')}</b>{MONTHS[p.data.date.getMonth()]}
                  </time>
                  <strong class="card-title">{p.data.title}</strong>
                  <span class="card-excerpt">{p.data.excerpt}</span>
                </a>
                <p class="card-tags">
                  <span class="card-subject">{SUBJECTS[p.data.shelf].name}</span>
                  {p.data.tags.map((t) => <button class="tag" data-tag={tagKey(t)}>{t}</button>)}
                </p>
              </li>
            ))}
          </ol>
        </li>
      ))}
    </ol>

    <div class="music-stand">
      <h3>On the piano</h3>
      <p>Two pieces I wrote. Click the piano in the corner, or pick one here.</p>
      <ul>
        {piano.map((piece) => (
          <li><button data-piano={piece.id} aria-pressed="false"><span class="glyph" data-glyph aria-hidden="true">▶</span> {piece.title} <span class="count">{minutes(piece.duration)}</span></button></li>
        ))}
      </ul>
    </div>
    <p class="panel-foot"><a href="/rss.xml">RSS</a></p>
    <script is:inline type="application/json" id="library-books" set:html={JSON.stringify(books).replace(/</g, '\\u003c')} />
  </section>

  <!-- the workshop has no side panel: the projects stand in the room, and these signs hang
       over them (pinned by src/island/workshop.ts). Without the island they're a plain list. -->
  <section class="workshop" data-panel="lighthouse" hidden aria-labelledby="lighthouse-title">
    <header class="workshop-banner">
      <h2 id="lighthouse-title" tabindex="-1">The lighthouse</h2>
      <p>The keeper's quarters. The coffee's on and the console's plugged in.</p>
      <button class="panel-close" data-close aria-label="Back to the island"><PixelIcon name="close" /></button>
    </header>
    <!-- a film on the telly: the player is laid over its screen while it plays (lighthouse.ts) -->
    <div class="film" data-film hidden>
      <div class="film-screen" data-film-screen></div>
      <button class="hud-btn film-off" data-film-off>Turn the telly off</button>
    </div>
  </section>
  <section class="workshop" data-panel="hut" hidden aria-labelledby="hut-title">
    <header class="workshop-banner">
      <h2 id="hut-title" tabindex="-1">The mountain hut</h2>
      <p>Nearly at the top. The stove's lit, the soup's on, and there's a bed made up in the corner.</p>
      <button class="panel-close" data-close aria-label="Back to the island"><PixelIcon name="close" /></button>
    </header>
  </section>
  <section class="workshop" data-panel="workshop" hidden aria-labelledby="workshop-title">
    <header class="workshop-banner">
      <h2 id="workshop-title" tabindex="-1">The workshop</h2>
      <p>Things I'm building. Most of them started as "wouldn't it be fun if…"</p>
      <button class="panel-close" data-close aria-label="Back to the island"><PixelIcon name="close" /></button>
    </header>
    <ul class="exhibits">
      {projects.map((p) => (
        <li class="exhibit" data-exhibit={p.id}>
          <button class="exhibit-sign" aria-expanded="false" aria-controls={`exhibit-${p.id}`}>{p.name}</button>
          <div class="exhibit-card" id={`exhibit-${p.id}`} role="group" aria-label={p.name} style={`--spine:${p.color}`} hidden>
            <button class="exhibit-close" data-deselect aria-label="Put it back"><PixelIcon name="close" /></button>
            <p class="exhibit-thing">{p.thing}</p>
            <div class="exhibit-title">
              <h3 tabindex="-1">{p.name}</h3>
              <span class="card-stamp exhibit-stamp">{p.tags[0]}</span>
            </div>
            <p class="exhibit-blurb">{p.blurb}</p>
            <p class="card-tags">{p.tags.slice(1).map((t) => <span class="tag">{t}</span>)}</p>
            {p.id === 'music' && (
              <div class="exhibit-player" data-player>
                <button data-record aria-pressed="false"><span data-glyph aria-hidden="true">▶</span> <span data-record-label>Put a record on</span></button>
                <p class="exhibit-now" data-now>{records.length} generated songs, played on a creaky old gramophone.</p>
              </div>
            )}
            <p class="exhibit-actions">
              {p.href !== `/blog/${p.post}/` && <a class="exhibit-btn" href={p.href} {...(p.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}>{p.href.includes('github.com') ? 'Source' : 'Visit'} ↗</a>}
              {p.source && p.source !== p.href && <a class="exhibit-btn" href={p.source} target="_blank" rel="noopener">Source ↗</a>}
              {p.post && <a class="exhibit-btn exhibit-read" href={`/blog/${p.post}/`} data-book={p.post}>Read the story →</a>}
            </p>
            <p class="exhibit-step">
              <button data-step="-1" aria-label="Previous project">←</button>
              <span>{projects.indexOf(p) + 1} / {projects.length}</span>
              <button data-step="1" aria-label="Next project">→</button>
            </p>
          </div>
        </li>
      ))}
    </ul>
    <aside class="project-list" data-list aria-label="All projects, by year">
      <button class="panel-close" data-list-close aria-label="Put the list away"><PixelIcon name="close" /></button>
      <h3>Every project</h3>
      {projectYears.map((y) => (
        <section>
          <h4>{y.year}</h4>
          <ul>
            {y.items.map((p) => (
              <li><button data-pick={p.id} style={`--spine:${p.color}`}>{p.name}</button></li>
            ))}
          </ul>
        </section>
      ))}
    </aside>
    <button class="hud-btn project-list-open" data-list-open hidden><PixelIcon name="book" />Project list</button>
  </section>

  <section class="panel" data-panel="campfire" hidden aria-labelledby="campfire-title">
    <button class="panel-close" data-close aria-label="Close"><PixelIcon name="close" /></button>
    <h2 id="campfire-title" tabindex="-1">By the campfire</h2>
    <p class="panel-lede">Hi, I'm Vincent. I design and build software, and I love making things, with
      AI and without: games, stories, drawings, odd little experiments. I write about what I learn along the way.
      When I'm not at a screen, I'm up a mountain, on a river, or losing an evening to a board game.</p>
    <p>This island is where it all ends up. Most things here have a story, and some only show up
      at the right hour. Pull up a log.</p>
    <p>I also build things like this for other people: interactive websites, 3D, AI and games.
      <a href="/commissions/">Here's how that works</a>.</p>
    <p>Want to talk about AI, a game idea or a good river? You'll find me here:</p>
    <ul class="links">
      {site.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>
  </section>

  <!-- the trail: a banner, and a card with the chapter you're at. A chapter with a diorama
       (src/island/trail.ts) shows it floating over the mountain; the others stay on their cairn. -->
  <section class="workshop trail-view" data-panel="trail" hidden aria-labelledby="trail-title">
    <header class="workshop-banner">
      <h2 id="trail-title" tabindex="-1">The mountain trail</h2>
      <p>Every cairn marks a stretch of the climb. The summit is where I am now.</p>
      <button class="panel-close" data-close aria-label="Back to the island"><PixelIcon name="close" /></button>
    </header>
    <div class="chapter-card">
      {chapters.map((c, i) => (
        <article class="chapter" data-chapter={c.id} hidden={i !== 0} aria-labelledby={`chapter-${c.id}`}>
          <p class="chapter-when">{c.era} · {c.years} · {c.where}</p>
          <h3 id={`chapter-${c.id}`}>{c.title}</h3>
          <p class="chapter-text">{c.text}</p>
          <ol class="chapter-roles">
            {c.roles.map((r) => (
              <li><strong>{r.role}</strong>, {r.org} <span class="years">{r.years}</span>{!c.things && <p>{r.text}</p>}</li>
            ))}
          </ol>
          {c.scene
            ? <p class="chapter-hint">Look around: most things here have a story.</p>
            : <p class="chapter-hint">The scene for this stretch is still being built.</p>}
        </article>
      ))}
      <p class="exhibit-step chapter-step">
        <button data-chapter-step="-1" aria-label="Down the trail">←</button>
        <span data-chapter-count>1 / {chapters.length}</span>
        <button data-chapter-step="1" aria-label="Up the trail">→</button>
      </p>
    </div>
    <!-- the pack goes the whole way up: it isn't part of any one chapter -->
    <button class="pack-toggle" data-pack-toggle aria-expanded="false" aria-controls="pack-card">What's in my pack</button>
    <aside class="pack-card" id="pack-card" hidden aria-labelledby="pack-title">
      <button class="exhibit-close" data-pack-toggle aria-label="Close the pack"><PixelIcon name="close" /></button>
      <h3 id="pack-title" tabindex="-1">What's in my pack</h3>
      <p class="pack-lede">What I carry up the mountain: picked up along the trail, in the workshop, or late at night.</p>
      <ul class="pack">
        {skills.map((s) => (
          <li><h3>{s.name}</h3><p class="card-tags">{s.items.map((i) => <span class="tag">{i}</span>)}</p><p class="pack-proof">{s.proof}</p></li>
        ))}
      </ul>
    </aside>
  </section>

  <!-- wild water: a river down the far side of the hill to a take-out (src/island/river.ts). The
       HUD along the top, and a card for pushing off, pausing and swimming. -->
  <section class="river" data-panel="river" hidden aria-labelledby="river-title" data-device="keys">
    <header class="river-hud">
      <p class="river-stat" title="Metres to the take-out"><span data-river-metres>0</span><small>m to go</small></p>
      <p class="river-stat river-time" title="Every second under par at the take-out is worth points"><span data-river-time>0:00</span></p>
      <p class="river-flow" data-river-flow title="Flow: builds as you paddle well, gone on a knock or a swim">×1.0</p>
      <p class="river-stat river-score"><span data-river-score>0</span><small>pts</small><em class="river-pace" data-river-pace title="Speed bonus: the faster you go, the more each metre's worth"></em></p>
      <p class="river-stat river-balls" title="Beike's tennis balls, fished out"><i class="river-ball" aria-hidden="true"></i><span data-river-balls>0</span></p>
      <p class="river-stat river-best">best <span data-river-best>0</span></p>
      <button class="panel-close" data-close aria-label="Back to the island"><PixelIcon name="close" /></button>
    </header>
    <div class="river-edge" data-river-edge aria-hidden="true"></div>
    <div class="river-flash" data-river-flash aria-hidden="true"></div>
    <div class="river-praise" data-river-praise aria-hidden="true"></div>
    <div class="river-gauge" data-river-gauge hidden aria-hidden="true"><i></i></div>
    <div class="river-sprint" data-river-sprint hidden aria-hidden="true"><i></i></div>
    <div class="river-brace" data-river-brace hidden aria-hidden="true"><i></i></div>
    <button class="river-sprint-go" data-river-sprint-go hidden>Sprint</button>
    <div class="river-roll" data-river-roll hidden aria-hidden="true"><span>Roll!</span><b></b></div>
    <div class="river-drop" data-river-drop hidden aria-hidden="true"><span>Line up</span><b><i></i></b></div>
    <p class="river-banner" data-river-banner hidden aria-live="polite"></p>
    <p class="river-hint" data-river-hint hidden aria-live="polite"></p>
    <div class="river-card" data-river-card="ready">
      <h2 id="river-title" tabindex="-1">Wild water</h2>
      <p class="river-lede">Rivers over the ridge, gentlest first.</p>
      <ol class="river-path" role="radiogroup" aria-label="Which river">
        {RIVERS.map((r, i) => (
          <li>
            <button class="river-stone" role="radio" aria-checked={i === 0 ? 'true' : 'false'} aria-label={`${r.name}, grade ${r.grade}`} data-river-pick={r.id} data-grade={r.grade}>
              <span class="river-stone-n">{i + 1}</span>
              <span class="river-stone-lock"><PixelIcon name="lock" size={14} /></span>
              <span class="river-stone-down" title="Made it down"><PixelIcon name="tick" size={10} /></span>
            </button>
          </li>
        ))}
      </ol>
      <div class="river-chosen" data-river-chosen aria-live="polite">
        <strong data-river-pick-name>{RIVERS[0].name}</strong>
        <span class="river-chosen-meta" data-river-pick-meta>Grade {RIVERS[0].grade} · {(RIVERS[0].length / 1000).toFixed(1)} km</span>
        <p class="river-pick-lede" data-river-pick-lede>{RIVERS[0].lede}</p>
        <ul class="river-goals" data-river-goals aria-label="Goals">
          {RIVERS[0].goals.map((g) => <li>{g.text} · {g.points}</li>)}
        </ul>
      </div>
      <ul class="river-keys">
        <li data-for="keys"><kbd>W</kbd> paddle · <kbd>A</kbd><kbd>D</kbd> turn · <kbd>Q</kbd><kbd>E</kbd> brake · <kbd>←</kbd><kbd>→</kbd> lean · <kbd>Space</kbd> brace</li>
        <li data-for="pad"><kbd>L2</kbd><kbd>R2</kbd> paddle (<kbd>✕</kbd> both) · <kbd>L1</kbd><kbd>R1</kbd> brake / brace · stick leans · <kbd>✕</kbd> braces when you're going over</li>
        <li data-for="touch">Hold both sides of the screen to paddle, one side to turn away from it; low down to brake on that side. Hold Sprint to dig in. Over a waterfall, flick a thumb up the screen to tuck.</li>
      </ul>
      <p class="river-pad-tip">Best with a controller: plug one in and press any button. No controller? It plays fine without.</p>
      <div class="river-tips river-tip-now">
        <dl>
          {RIVER_TIPS.map(([art, when, what]) => (
            <div data-river-tip hidden>
              <RiverTipArt name={art} />
              <dt>{when}</dt>
              <dd>{what}</dd>
            </div>
          ))}
        </dl>
      </div>
      <details class="river-how">
        <summary>How it works</summary>
        <p class="river-hint-line" data-for="keys"><kbd>↑</kbd><kbd>↓</kbd> lean forward / back · <kbd>S</kbd> back-paddle · <kbd>Shift</kbd> (hold) sprint · <kbd>P</kbd> or <kbd>Esc</kbd> pause</p>
        <p class="river-hint-line" data-for="pad"><kbd>□</kbd>, <kbd>L3</kbd> or a trigger squeezed right in (hold) sprint · Options pauses · on the cards, the d-pad moves, <kbd>✕</kbd> picks, <kbd>○</kbd> goes back</p>
        <p class="river-hint-line">Read the water: long bright streaks are the fast line, and arrows ride down the dark V of a tongue; a ledge's lip glows gold at the moment to boof it; coming to a waterfall, hold the needle in the green to go over straight, then lean forward as it falls into the gold, not before; behind rocks and inside bends it turns back upstream, an eddy to catch. Lean into your turns, or the eddy line trips you. Down a straight the waves stand in a train: a crest leaning across the river rolls you, so lean into it (or square up), and a stroke as you slide down a wave's back pumps you on. Paddle on one side and you turn away from it. A blade planted as a brake only bites as fast as you're moving through the water; a reverse sweep always does. Forward on one side, reverse on the other, in rhythm: that's a 360. Boofs, braces, gates and good lines build your flow; a knock or a swim loses it. Score is distance × flow, up to double for speed; every capsize costs you. Make it to the take-out and it pays again: every second under par (times your flow), every gate and every ball. Every river has three goals of its own, and each pays every time you do it.</p>
      </details>
      <details class="river-how river-tips">
