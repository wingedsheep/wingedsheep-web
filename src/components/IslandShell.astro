<script>
  const host = document.getElementById('island')!;
  // the page (and on a post, the book) loads and paints first; the island comes in behind it, so
  // its download and set-up never hold up the words
  const loaded = new Promise((done) => (document.readyState === 'complete' ? done(0) : addEventListener('load', done, { once: true })));
  // (the browser says when it has painted; where it can't, a second is plenty)
  const painted = new Promise((done) => {
    if (performance.getEntriesByName('first-contentful-paint').length) return done(0);
    try {
      new PerformanceObserver((list, observer) => {
        if (!list.getEntriesByName('first-contentful-paint').length) return;
        observer.disconnect();
        done(0);
      }).observe({ type: 'paint', buffered: true });
    } catch {}
    setTimeout(done, 1000);
  });
  Promise.all([loaded, painted])
    .then(() => new Promise((next) => setTimeout(next)))
    .then(() => import('../island/main'))
    .then(({ bootIsland }) => bootIsland(host))
    .catch((err) => {
      console.error(err);
      host.innerHTML = '<p class="island-loading">The island is hidden in fog. <a href="/plain/">Here is everything in plain text.</a></p>';
    });
</script>
